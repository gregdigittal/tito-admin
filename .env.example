APP_NAME="Tito Admin"
APP_ENV=local
APP_KEY=
# Set to true only for local development
APP_DEBUG=false
APP_URL=http://localhost:8000

# Tito api-service (j-payments GraphQL)
TITO_API_URL=https://tito-api.onrender.com
TITO_GRAPHQL_ENDPOINT=

LOG_CHANNEL=stack
# Use debug only for local development
LOG_LEVEL=warning

SESSION_DRIVER=file
SESSION_LIFETIME=30
# Set to true in production (HTTPS)
SESSION_SECURE_COOKIE=false

# For production: use database or redis
# SESSION_DRIVER=database
# SESSION_DRIVER=redis