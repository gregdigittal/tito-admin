APP_NAME="Tito Admin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Tito api-service (j-payments GraphQL)
TITO_API_URL=https://tito-api.onrender.com
TITO_GRAPHQL_ENDPOINT=

LOG_CHANNEL=stack
LOG_LEVEL=debug

SESSION_DRIVER=file
SESSION_LIFETIME=120

# For production: use database or redis
# SESSION_DRIVER=database
# SESSION_DRIVER=redis
